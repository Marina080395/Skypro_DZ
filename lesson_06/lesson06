from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Создание экземпляра драйвера
driver = webdriver.Chrome()

try:
    # Переход на страницу
    driver.get("http://uitestingplayground.com/ajax")

    # Поиск кнопки и ожидание пока она станет кликабельной
    blue_button = WebDriverWait(driver, 10).until(
        EC.element_to_be_clickable((By.XPATH, "//button"))
    )
    blue_button.click()

    # Ожидание появления зелёного блока с текстом
    success_message = WebDriverWait(driver, 10).until(
        EC.visibility_of_element_located((By.CLASS_NAME, "bg-success"))
    )
    print(success_message.text.strip())  # Выведет: Data loaded with AJAX get request.

finally:
    driver.quit()


from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Создание экземпляра драйвера
driver = webdriver.Chrome()

try:
    # Переход на страницу
    driver.get("http://uitestingplayground.com/textinput")

    # Заполняем поле ввода
    text_input = WebDriverWait(driver, 10).until(
        EC.presence_of_element_located((By.ID, "newButtonName"))
    )
    text_input.clear()
    text_input.send_keys("SkyPro")

    # Находим и нажимаем кнопку
    submit_button = WebDriverWait(driver, 10).until(
        EC.element_to_be_clickable((By.XPATH, "//button[@type='submit']"))
    )
    submit_button.click()

    # Подтверждение, что текст изменился
    updated_button_text = WebDriverWait(driver, 10).until(
        EC.text_to_be_present_in_element((By.TAG_NAME, "h3"), "SkyPro")
    )
    print(updated_button_text)  # Выведет: True

finally:
    driver.quit()


from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Создание экземпляра драйвера
driver = webdriver.Chrome()

try:
    # Переход на страницу
    driver.get("https://bonigarcia.dev/selenium-webdriver-java/loading-images.html")

    # Ждем, пока все три изображения станут видимыми
    images = WebDriverWait(driver, 10).until(
        EC.all_of(
            *[EC.visibility_of_any_elements_located((By.CSS_SELECTOR, ".img-responsive"))]
        )
    )

    # Получаем третий элемент списка изображений
    third_image = images[2]
    image_src = third_image.get_attribute("src")
    print(image_src)

finally:
    driver.quit()